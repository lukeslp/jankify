<!--
  File Purpose: Keep Jankify private data out of legacy Android backups.
  Primary Functions: Exclude every app-owned path before Android 12.
  Inputs/Outputs: Consumed by Android backup services; exports no application data.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
